# Never commit the real .env. In production use your host's secret manager.
DATABASE_USER=gatemate
DATABASE_PASSWORD=change-me
PUBLIC_URL=https://gatemate.app
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# RS256 key pair for access tokens:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt.pem && openssl rsa -in jwt.pem -pubout -out jwt.pub
JWT_ISSUER=https://api.gatemate.app
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Sign in with Apple (Apple Developer → Keys → Sign in with Apple, .p8 contents)
APPLE_AUDIENCES=app.gatemate.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=app.gatemate.ios
APPLE_PRIVATE_KEY=

# Google Sign-In OAuth client IDs (iOS, Android, Web), comma separated
GOOGLE_AUDIENCES=

# Booking e-mail import (inbound mail provider webhook)
INBOUND_EMAIL_SECRET=
IMPORT_EMAIL_DOMAIN=

# Optional licensed data providers
UNSPLASH_ACCESS_KEY=
AERODATABOX_KEY=

# Gatemate Pro (RevenueCat → App Store / Google Play)
# Webhook: RevenueCat → Integrations → Webhooks → URL https://<api>/api/v1/billing/revenuecat, Authorization header = this value
REVENUECAT_WEBHOOK_SECRET=
# Optional: RevenueCat secret API key (sk_...), lets the server confirm a purchase instantly
REVENUECAT_SECRET_KEY=
